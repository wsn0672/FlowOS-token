PORT=3743
HOST=0.0.0.0
ADMIN_PORT=3744
# Password-free log viewer, accessible on the server itself or through an SSH tunnel.
ADMIN_HOST=127.0.0.1
ADMIN_ALLOWED_HOSTS=localhost,127.0.0.1,::1,[::1]

# Default requires /mnt/timemachine to be mounted on Linux.
# Leave unset in production to retain the mount check.
# PROXY_LOG_DIR=/mnt/timemachine/flowos-logs

# Local Cloudflare Tunnel works by default: loopback peers are trusted.
# Prefer valid CF-Connecting-IP; otherwise use X-Forwarded-For.
# For other proxy addresses, list only trusted proxy IPs/CIDRs.
# TRUST_PROXY=loopback
# Set TRUST_PROXY= (empty) to ignore all forwarded client IP headers.

# Enable Rammerhead by routing a separate public hostname to the same port (3743).
# Leave the incoming Host header unchanged. Do not publish the admin port.
# FLOWOS_ORIGIN=https://flow.example.com
# RAMMERHEAD_ORIGIN=https://rammerhead.example.com

# Optional absolute path to a Markdown announcement kept outside the Git checkout.
# ANNOUNCEMENT_FILE=/home/wsn0672/flowos-announcement.md
