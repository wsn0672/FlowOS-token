# Required: choose a long, unique password. Never commit the actual .env file.
SITE_PASSWORD=

# Set true when serving over HTTPS, including HTTPS terminated by a trusted proxy.
COOKIE_SECURE=false

# Optional: comma-separated trusted proxy IP addresses/CIDRs (not client IPs).
# TRUST_PROXY=127.0.0.1,::1

# Persistent lock state. Keep outside public/ and on a persistent writable volume.
AUTH_STATE_PATH=./data/auth-locks.json
